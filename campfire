# ---------- small helpers ----------

def cname(name):
    """Name in a color that's always the same for the same person."""
    code = PALETTE[zlib.crc32(name.lower().encode()) % len(PALETTE)]
    return f"\033[1;38;5;{code}m{name}{RESET}"


def clean(text, limit=500):
    """Strip control characters so nobody can mess with your terminal."""
    return "".join(ch for ch in str(text) if ch.isprintable())[:limit]


def stamp():
    return datetime.now().strftime("%H:%M")


def human_size(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def safe_filename(name):
    """Only the bare file name, never a path, and never a hidden/dot file."""
    base = clean(os.path.basename(str(name).replace("\\", "/")), 120).lstrip(".").strip()
    return base or "file"


def unique_path(directory, filename):
    p = directory / filename
    n = 1
    while p.exists() or p.with_name(p.name + ".part").exists():
        p = directory / f"{Path(filename).stem} ({n}){Path(filename).suffix}"
        n += 1
    return p


def tilde(path):
    s = str(path)
    home = str(Path.home())
    return "~" + s[len(home):] if s.startswith(home) else s


def resolve_path(text):
    """Be forgiving about how someone typed or dragged in a path."""
    text = text.strip().strip("'\"")
    if not text:
        return None
    home = Path.home()
    cands = [os.path.expanduser(text)]
    if text.startswith("~/") and text[2:].lower().startswith("users/"):
        cands.append("/" + text[2:])  # "~/users/me/x" was meant as "/Users/me/x"
    if "/" not in text:  # just a file name: look in the usual places
        for d in (Path.cwd(), home / "Desktop", home / "Downloads", home / "Documents"):
            cands.append(str(d / text))
    for c in cands:
        c = c.rstrip("/") or "/"
        if os.path.exists(c):
            return os.path.abspath(c)
    return None


def parse_send_args(rest):
    """Work out what /send was asked to do. Returns (path, recipient, use_picker)."""
    rest = rest.strip()
    if not rest:
        return None, None, True  # plain /send: open the file picker
    p = resolve_path(rest)  # the whole thing is a path (handles unquoted spaces)
    if p:
        return p, None, False
    try:
        args = shlex.split(rest)
    except ValueError:  # e.g. an unquoted apostrophe in the name
        args = rest.split()
    for k in range(len(args), 0, -1):
        p = resolve_path(" ".join(args[:k]))
        if p and len(args) - k <= 1:
            return p, (args[k] if k < len(args) else None), False
    if len(args) == 1:
        return None, args[0], True  # probably "/send sam": pick a file for Sam
    return None, None, False


def pick_file():
    """Open the standard macOS file window. Returns (path, message_if_none)."""
    if sys.platform != "darwin":
        return None, "The file window only works on a Mac. Use /send <path> instead."
    script = ["tell current application", "activate",
              'set f to choose file with prompt "Pick a file to share on campfire"',
              "end tell", "POSIX path of f"]
    cmd = ["osascript"]
    for line in script:
        cmd += ["-e", line]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except OSError:
        return None, "Couldn't open the file window."
    if r.returncode != 0:
        return None, "Cancelled." if "-128" in r.stderr else "Couldn't open the file window."
    path = r.stdout.strip()
    return (path, None) if path else (None, "Cancelled.")


_last_notify = [0.0]


def notify(title, text, sound="Pop", force=False):
    """macOS desktop notification (rate-limited so a busy room isn't a nightmare)."""
    if sys.platform != "darwin":
        return
    now = time.time()
    if not force and now - _last_notify[0] < 2.0:
        return
    _last_notify[0] = now

    def esc(s):
        return s.replace("\\", "\\\\").replace('"', '\\"')

    script = (f'display notification "{esc(text[:200])}" '
              f'with title "{esc(title)}" sound name "{sound}"')
    try:
        subprocess.Popen(["osascript", "-e", script],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def say(text):
    """Print a line without wrecking whatever the user is typing."""
    buf = readline.get_line_buffer() if readline else ""
    sys.stdout.write("\r\033[K" + text + "\n> " + buf)
    sys.stdout.flush()


# ---------- self-update ----------

class UpdateError(Exception):
    pass


def version_tuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v))


def download_latest():
    """Fetch the newest campfire source from GitHub."""
    last = "couldn't reach GitHub"
    for url in UPDATE_URLS:
        req = urllib.request.Request(
            f"{url}?cb={int(time.time())}",  # dodge GitHub's short-lived cache
            headers={"User-Agent": f"campfire/{VERSION}"})
        try:
            with urllib.request.urlopen(req, timeout=15) as r:
                data = r.read(2_000_001)
            if len(data) > 2_000_000:
                raise UpdateError("The downloaded file is much bigger than expected, so I stopped.")
            return data.decode("utf-8")
        except urllib.error.HTTPError as e:
            last = f"GitHub said {e.code} for {url}"
        except UnicodeDecodeError:
            raise UpdateError("The downloaded file wasn't readable text, so I stopped.")
        except OSError as e:
            reason = str(getattr(e, "reason", e))
            if "CERTIFICATE_VERIFY_FAILED" in reason:
                raise UpdateError(
                    "Your Python can't verify GitHub's security certificate. If you installed "
                    "Python from python.org, open the Python folder in Applications and run "
                    "'Install Certificates.command', then try again.")
            raise UpdateError(f"Couldn't download the update ({reason}). Are you online?")
    raise UpdateError(f"Couldn't find campfire in the repo ({last}).")


def validate_update(text):
    """Make sure the download really looks like campfire. Returns its version."""
    m = re.search(r'^VERSION = "([0-9][0-9.]*)"', text, re.M)
    if (not m or len(text) < 2000 or not text.startswith("#!/usr/bin/env python3")
            or "def main" not in text):
        raise UpdateError("The downloaded file doesn't look like campfire, so I didn't install it.")
    try:
        compile(text, "campfire-update", "exec")  # syntax check only, never runs it
    except SyntaxError:
        raise UpdateError("The downloaded file is broken, so I didn't install it.")
    return m.group(1)


def install_update(text, target):
    """Replace the installed copy. Asks for the Mac password if the folder is protected."""
    folder = os.path.dirname(target)
    tmp = None
    try:
        fd, tmp = tempfile.mkstemp(dir=folder, prefix=".campfire-update-")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o755)
        os.replace(tmp, target)
        return
    except OSError:
        if tmp and os.path.exists(tmp):
            try:
                os.remove(tmp)
            except OSError:
                pass
    # The folder is protected (like /usr/local/bin): do it with sudo instead.
    print("Your Mac needs your password to replace the installed copy (nothing shows as you type).")
    stage = tempfile.mkdtemp(prefix="campfire-update-")
    try:
        staged = os.path.join(stage, "campfire")
        with open(staged, "w", encoding="utf-8") as f:
            f.write(text)
        r = subprocess.run(["sudo", "install", "-m", "755", staged, target])
        if r.returncode != 0:
            raise UpdateError("The install didn't go through, so nothing was changed.")
    finally:
        shutil.rmtree(stage, ignore_errors=True)


def run_update(check_only=False, target=None):
    target = target or os.path.realpath(__file__)
    print(f"campfire v{VERSION}. Checking for updates...")
    try:
        text = download_latest()
        latest = validate_update(text)
        if version_tuple(latest) <= version_tuple(VERSION):
            print(f"{ORANGE}🔥 You're up to date.{RESET}")
            return
        print(f"New version available: v{VERSION} → {BOLD}v{latest}{RESET}")
        if check_only:
            print("Type 'campfire update' to install it.")
            return
        try:
            answer = input("Install it? (y/n) ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if answer not in ("y", "yes"):
            print("No changes made.")
            return
        install_update(text, target)
    except UpdateError as e:
        print(e)
        return
    r = subprocess.run([sys.executable, target, "version"], capture_output=True, text=True)
    if latest in r.stdout:
        print(f"{ORANGE}✔ Updated!{RESET} You now have {BOLD}v{latest}{RESET}. Open campfire again to use it.")
    else:
        print("Installed, but I couldn't double-check it. Try 'campfire version'.")


# ---------- uninstall ----------

def run_remove(target=None, assume_yes=False):
    target = target or os.path.realpath(__file__)
    print("This will remove campfire from your Mac:")
    print(f"  {target}")
    if DOWNLOAD_DIR.exists():
        print(f"{DIM}Files you downloaded with it (in {tilde(DOWNLOAD_DIR)}) will be kept.{RESET}")
    if not assume_yes:
        try:
            answer = input("Remove it? (y/n) ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if answer not in ("y", "yes"):
            print("No changes made.")
            return
    try:
        os.remove(target)
    except FileNotFoundError:
        pass
    except OSError:
        print("Your Mac needs your password to remove it (nothing shows as you type).")
        r = subprocess.run(["sudo", "rm", "-f", target])
        if r.returncode != 0:
            print("That didn't go through, so nothing was changed.")
            return
    print(f"{ORANGE}🌙 campfire has been removed.{RESET} Thanks for stopping by the fire!")
    print(f"{DIM}To get it back, install it again any time.{RESET}")


