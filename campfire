Sent = namedtuple("Sent", "mid data dests ok")


def parse(data):
    try:
        m = json.loads(data.decode())
        return m if isinstance(m, dict) else None
    except (ValueError, UnicodeDecodeError):
        return None


class Transport:
    """Gets messages to people, and gets their messages to us.

    Wi-Fi networks treat broadcast traffic badly, so every message goes out several
    ways at once (each network's own broadcast address, multicast, and straight to
    people we've already heard from). The first copy to arrive wins; the rest are
    thrown away by the receiver.
    """

    def __init__(self, ident=None, peers=()):
        self.ident = ident
        self.peers = list(peers)       # people added by hand: [(ip, port)]
        self.learned = lambda: []      # set by chat(): addresses of people we've heard from
        self.ifaces = []
        self.last_error = None
        self.lock = threading.Lock()
        self._joined = set()
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        if hasattr(socket, "SO_REUSEPORT"):
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 1)  # never leave the LAN
        s.bind(("", PORT))
        s.settimeout(0.5)
        self.sock = s
        self.refresh_interfaces()

    def refresh_interfaces(self):
        """Re-check which networks we're on (laptops move around). True if it changed."""
        found = local_interfaces()
        with self.lock:
            changed = [(i[1], i[2]) for i in found] != [(i[1], i[2]) for i in self.ifaces]
            self.ifaces = found
            for ip in [i[1] for i in found] or ["0.0.0.0"]:
                if ip in self._joined:
                    continue
                try:
                    self.sock.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP,
                                         socket.inet_aton(MCAST_GROUP) + socket.inet_aton(ip))
                    self._joined.add(ip)
                except OSError:
                    pass  # multicast isn't available here; the other routes still work
        return changed

    def _targets(self):
        """Every way we try to reach people: [(address, multicast_interface_or_None)]."""
        out = []
        for _, ip, bcast in self.ifaces:
            out.append(((bcast or "255.255.255.255", PORT), None))
            out.append(((MCAST_GROUP, PORT), ip))
        if not self.ifaces:
            out += [(("255.255.255.255", PORT), None), ((MCAST_GROUP, PORT), None)]
        for addr in list(self.learned()) + list(self.peers):
            out.append((tuple(addr), None))
        unique = []
        for t in out:
            if t not in unique:
                unique.append(t)
        return unique

    def transmit(self, data, dests=None):
        """Send raw bytes: to specific people, or every way we know. True if anything went out."""
        targets = [(tuple(d), None) for d in dests] if dests else self._targets()
        ok = False
        with self.lock:
            for addr, mcast_if in targets:
                try:
                    if mcast_if:
                        self.sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF,
                                             socket.inet_aton(mcast_if))
                    self.sock.sendto(data, addr)
                    ok = True
                except OSError as e:
                    self.last_error = str(e)
        if ok:
            self.last_error = None
        return ok

    def send(self, kind, room, name, text="", dest=None, to=None, mid=None, **extra):
        """Build, sign and send a message. dest=(ip, port) sends to just that one person."""
        msg = {"v": PROTO, "k": kind, "id": MY_ID, "room": room, "name": name, "text": text,
               "mid": mid or secrets.token_hex(6), "ts": int(time.time())}
        if to:
            msg["to"] = to
        msg.update(extra)
        if self.ident:
            msg["pk"] = b64e(self.ident.pk)
            msg["sig"] = b64e(self.ident.sign(canonical(msg)))
        data = json.dumps(msg).encode()
        dests = [dest] if dest else None
        return Sent(msg["mid"], data, dests, self.transmit(data, dests))

    def recv(self):
        """Next packet as (message, sender_address, verified_public_key_or_None), or None.

        Raises OSError once the socket is closed. Packets with a bad signature are dropped.
        """
        try:
            data, addr = self.sock.recvfrom(8192)
        except socket.timeout:
            return None
        m = parse(data)
        if not m:
            return None
        pk = None
        if HAVE_CRYPTO and "sig" in m:
            pk = verify_packet(m)
            if pk is None:
                return None  # forged or damaged
        return m, addr, pk

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def open_transport(ident=None, peers=()):
    try:
        return Transport(ident, peers)
    except OSError as e:
        print(f"Couldn't open campfire's network port ({e}). Is another program using it?")
        return None


def find_fires(tp, seconds=3.0, room="*"):
    """Ask who's lit a room and listen for answers. Returns {room: host_name}."""
    fires = {}
    start = time.time()
    end, next_ask = start + seconds, start
    while time.time() < end:
        if time.time() >= next_ask:
            tp.send("probe", room, "?")  # hosts answer right away instead of making us wait
            next_ask += 1.0
        try:
            pkt = tp.recv()
        except OSError:
            break
        if pkt is None:
            continue
        m = pkt[0]
        if m.get("k") == "beacon" and m.get("id") != MY_ID:
            fires[clean(m.get("room", "?"), 40)] = clean(m.get("name", "?"), 24)
    return fires


def chunk_text(text, limit=TEXT_LIMIT):
    """Split a long message at spaces so every piece fits in one packet."""
    parts = []
    while len(text) > limit:
        cut = text.rfind(" ", 0, limit + 1)
        if cut < limit // 2:
            cut = limit
        piece = text[:cut].strip()
        if piece:
            parts.append(piece)
        text = text[cut:].strip()
    if text:
        parts.append(text)
    return parts


# ---------- who's around, and who they really are ----------

class Roster:
    """Everyone we've heard from lately, and whether they're who they claim to be."""

    def __init__(self, name, ident, pins):
        self.me = name
        self.ident = ident
        self.pins = pins
        self.my_person = ident.fp if ident else MY_ID
        self.lock = threading.RLock()
        self.members = {}
        self.secure_sids = set()  # sessions that have proven themselves with signatures
        if pins and ident:
            pins.set(name, ident.fp)  # this name is yours

    @staticmethod
    def person(mem):
        return mem["fp"] or mem["sid"]

    def touch(self, m, addr, pk):
        sid = str(m.get("id", ""))
        fp = fingerprint(pk) if pk else None
        key = f"{fp}/{sid}" if pk else sid
        try:
            ver = int(m.get("v", 1))
        except (TypeError, ValueError):
            ver = 1
        with self.lock:
            mem = self.members.get(key)
            if mem is None:
                mem = self.members[key] = {"key": key, "sid": sid, "fp": fp, "pk": pk,
                                           "changed": False, "warned": False}
            mem.update(name=clean(m.get("name", "?"), 24) or "?", addr=addr,
                       last=time.time(), ver=ver)
            if pk:
                self.secure_sids.add(sid)
            self._check_pin(mem)
            if len(self.members) > 200:
                old = time.time() - 300
                self.members = {k: v for k, v in self.members.items() if v["last"] > old}
            return mem

    def _check_pin(self, mem):
        if not self.pins or not mem["fp"]:
            return
        pinned = self.pins.get(mem["name"])
        if pinned is None:
            self.pins.set(mem["name"], mem["fp"])  # first time we've met this name
        mem["changed"] = pinned is not None and pinned != mem["fp"]

    def take_warning(self, mem):
        """A one-time warning if this name now belongs to a different identity."""
        if mem["changed"] and not mem["warned"]:
            mem["warned"] = True
            return (f"{RED}⚠{RESET} {BOLD}{mem['name']}{RESET} is using a different identity from "
                    f"the {mem['name']} you've talked to before. That could be a new computer, "
                    f"or someone pretending. Check with them (try {BOLD}/id{RESET}), then type "
                    f"{BOLD}/trust {self.label(mem)}{RESET} if it's really them.")
        return None

    def trust(self, mem):
        with self.lock:
            self.pins.set(mem["name"], mem["fp"])
            for x in self.members.values():
                self._check_pin(x)

    def drop(self, m, pk):
        sid = str(m.get("id", ""))
        key = f"{fingerprint(pk)}/{sid}" if pk else sid
        with self.lock:
            return self.members.pop(key, None)

    def by_key(self, key):
        with self.lock:
            return self.members.get(key)

    def active(self):
        now = time.time()
        with self.lock:
            return [x for x in self.members.values() if now - x["last"] < 12]

    def unicast_addrs(self):
        """Where to send things directly. Old campfires are left out: they'd show duplicates."""
        return [x["addr"] for x in self.active() if x["ver"] >= 2]

    def label(self, mem):
        """Their name, plus #tag when somebody else is using the same name."""
        same = mem["name"].lower()
        clash = ((same == self.me.lower() and self.person(mem) != self.my_person)
                 or any(x is not mem and x["name"].lower() == same
                        and self.person(x) != self.person(mem) for x in self.active()))
        return mem["name"] + (f"#{(mem['fp'] or mem['sid'])[:4]}" if clash else "")

    def display(self, mem):
        """Colored name, with a warning if their identity changed or they're unverified."""
        s = cname(self.label(mem))
        if mem["changed"]:
            s = f"{RED}⚠{RESET}" + s
        elif self.ident and not mem["pk"]:
            s += f"{DIM}?{RESET}"
        return s

    def find(self, text):
        """Look someone up by name. Returns (member, None) or (None, problem)."""
        t = text.lstrip("@").lower()
        act = self.active()
        hits = [x for x in act if self.label(x).lower() == t] or [x for x in act if x["name"].lower() == t]
        if not hits:
            return None, "none"
        if len({self.person(x) for x in hits}) > 1:
            names = ", ".join(sorted({self.label(x) for x in hits}, key=str.lower))
            return None, f"More than one person is using that name: {names}. Use the full name with the #tag."
        return max(hits, key=lambda x: x["last"]), None

    def people(self):
        """One entry per person (someone with two windows open counts once)."""
        seen, out = set(), []
        for x in sorted(self.active(), key=lambda x: x["name"].lower()):
            p = (self.person(x), x["name"].lower())
            if p not in seen:
                seen.add(p)
                out.append(x)
        return out


# ---------- file sharing (direct TCP) ----------

class FileServer:
    """Serves files you've offered. Starts only when you first use /send."""

    def __init__(self):
        self.shares = {}  # token -> {path, filename, size, to}
        self.sock = None
        self.port = None
        self.stop = threading.Event()

    def start(self):
        if self.sock:
            return
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind(("", 0))
        s.listen(5)
        s.settimeout(0.5)
        self.sock = s
        self.port = s.getsockname()[1]
        threading.Thread(target=self._accept_loop, daemon=True).start()

    def _accept_loop(self):
        while not self.stop.is_set():
            try:
                conn, _ = self.sock.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            threading.Thread(target=self._serve, args=(conn,), daemon=True).start()

    def _serve(self, conn):
        try:
            conn.settimeout(10)
            line = b""
            while not line.endswith(b"\n") and len(line) < 128:
                ch = conn.recv(1)
                if not ch:
                    return
                line += ch
            parts = line.decode(errors="replace").split()
            share = self.shares.get(parts[1]) if len(parts) == 2 and parts[0] == "GET" else None
            if not share or not os.path.isfile(share["path"]):
                conn.sendall(b"ERR\n")
                return
            with open(share["path"], "rb") as f:
                size = os.fstat(f.fileno()).st_size
                conn.sendall(f"OK {size}\n".encode())
                conn.settimeout(30)
                while True:
                    chunk = f.read(65536)
                    if not chunk:
                        break
                    conn.sendall(chunk)
        except OSError:
            pass
        finally:
            conn.close()

    def close(self):
        self.stop.set()
        if self.sock:
            try:
                self.sock.close()
            except OSError:
                pass


def announce(tp, roster, room, name, token, share, port):
    """Tell the room (or just one person) about a file we're offering."""
    dest, extra = None, {}
    if share.get("to_key"):
        mem = roster.by_key(share["to_key"])
        if mem is None:
            return  # they've left
        dest, extra["tid"] = mem["addr"], mem["sid"]
    tp.send("offer", room, name, share["filename"], dest=dest, to=share.get("to"),
            size=share["size"], port=port, token=token, **extra)


def fetch(offer, dest_dir):
    """Download an offered file. Returns (saved_path, size). Raises OSError on failure."""
    dest_dir.mkdir(parents=True, exist_ok=True)
    with socket.create_connection((offer["ip"], offer["port"]), timeout=10) as s:
        s.settimeout(30)
        s.sendall(f"GET {offer['token']}\n".encode())
        f = s.makefile("rb")
        header = f.readline(128).decode(errors="replace").split()
        if len(header) != 2 or header[0] != "OK" or not header[1].isdigit():
            raise OSError("the sender no longer has this file")
        size = int(header[1])
        dest = unique_path(dest_dir, offer["filename"])
        part = dest.with_name(dest.name + ".part")
        try:
            with open(part, "wb") as out:
                remaining = size
                while remaining > 0:
                    chunk = f.read(min(65536, remaining))
                    if not chunk:
                        raise OSError("the connection dropped before the file finished")
                    out.write(chunk)
                    remaining -= len(chunk)
            os.replace(part, dest)
        except BaseException:
            try:
                os.remove(part)
            except OSError:
                pass
            raise
    return dest, size


def download_in_background(offer):
    try:
        dest, size = fetch(offer, DOWNLOAD_DIR)
        say(f"{ORANGE}✔{RESET} Saved {BOLD}{tilde(dest)}{RESET} {DIM}({human_size(size)}){RESET}")
    except OSError as e:
        say(f"{DIM}Couldn't download {offer['filename']}: {e}. "
            f"(The sender may have left, or a firewall may be in the way.){RESET}")


# ---------- listening ----------

def listen(tp, ident, room, name, host, roster, state, stop):
    seen = OrderedDict()  # recent (sender, message id) pairs, to drop duplicate copies
    while not stop.is_set():
        try:
            pkt = tp.recv()
        except OSError:
            break
        if pkt is None:
            continue
        m, addr, pk = pkt
        sid = str(m.get("id", ""))
        kind = m.get("k")
        if sid == MY_ID:
            continue
        if kind == "probe":  # someone's looking for fires
            if host and m.get("room") in ("*", room):
                tp.send("beacon", room, name, dest=addr)
            continue
        if m.get("room") != room:
            continue
        if pk is None and sid in roster.secure_sids:
            continue  # this session has signed everything so far; unsigned means forged
        if pk is not None:
            ts = m.get("ts")
            if not isinstance(ts, (int, float)) or abs(time.time() - ts) > MAX_SKEW:
                continue  # too old or too new: probably a replay
        mid = m.get("mid")
        if mid:
            key = (sid, str(mid))
            if key in seen:  # a copy that came by another route
                if kind == "whisper" and m.get("tid") == MY_ID:
                    tp.send("ack", room, name, dest=addr, ref=str(mid))  # our ack may have been lost
                continue
            seen[key] = True
            while len(seen) > 4096:
                seen.popitem(last=False)

        who = clean(m.get("name", "?"), 24)
        muted = state["mute"]

        if kind == "bye":
            mem = roster.drop(m, pk)
            state["offers"] = [o for o in state["offers"] if o["sender"] != (mem["key"] if mem else sid)]
            say(f"{DIM}* {RESET}{roster.display(mem) if mem else cname(who)}{DIM} wandered off{RESET}")
            continue

        mem = roster.touch(m, addr, pk)
        warning = roster.take_warning(mem)
        if warning:
            say(warning)
        stamp_s = f"{DIM}{stamp()}{RESET}"

        if kind == "spark":
            text = clean(m.get("text", ""))
            say(f"{stamp_s} {roster.display(mem)}: {text}")
            if not muted:
                notify(f"{roster.label(mem)} in {room}", text)
        elif kind == "whisper":
            tid = m.get("tid")
            mine = (tid == MY_ID) if tid is not None else str(m.get("to", "")).lower() == name.lower()
            if not mine:
                continue
            note = ""
            if "ct" in m:  # encrypted: only readable by us, and only if it's really from them
                if not (ident and pk):
                    continue
                try:
                    text = clean(ident.decrypt_from(pk, b64d(m["ct"])).decode("utf-8"))
                except Exception:
                    continue
                note = " 🔒"
            else:
                text = clean(m.get("text", ""))
                if ident:
                    note = f" {DIM}(not encrypted){RESET}"
            say(f"{stamp_s} {MAGENTA}[whisper from{RESET} {roster.display(mem)}{MAGENTA}]{RESET}{note} {text}")
            if mem["ver"] >= 2 and mid:
                tp.send("ack", room, name, dest=addr, ref=str(mid))
            if not muted:
                notify(f"{roster.label(mem)} whispered to you", text, sound="Glass", force=True)
        elif kind == "ack":
            entry = state["pending"].get(m.get("ref"))
            if entry and entry[1] == mem["key"]:
                entry[0].set()
        elif kind == "offer":
            tid, to = m.get("tid"), m.get("to")
            if tid is not None:
                if tid != MY_ID:
                    continue  # a private offer meant for someone else
            elif to and str(to).lower() != name.lower():
                continue
            token = str(m.get("token", ""))
            if not token or any(o["token"] == token for o in state["offers"]):
                continue  # already know about this one (offers are re-announced)
            try:
                port = int(m["port"])
                size = int(m["size"])
            except (KeyError, ValueError, TypeError):
                continue
            filename = safe_filename(m.get("text", ""))
            n = state["next"]
            state["next"] += 1
            state["offers"] = (state["offers"] + [{
                "n": n, "sender": mem["key"], "from": roster.label(mem), "filename": filename,
                "size": size, "ip": addr[0], "port": port, "token": token,
            }])[-20:]
            how = "is sharing" if not (to or tid) else "is privately sharing"
            say(f"{stamp_s} {ORANGE}📎{RESET} {roster.display(mem)} {how} {BOLD}{filename}{RESET} "
                f"{DIM}({human_size(size)}){RESET}. Type {BOLD}/get {n}{RESET} to download it.")
            if not muted:
                notify(f"{roster.label(mem)} shared a file", f"{filename} ({human_size(size)})",
                       sound="Glass", force=True)
        elif kind == "hello":
            say(f"{DIM}* {RESET}{roster.display(mem)}{DIM} sat down by the fire{RESET}")
            tp.send("hb", room, name, dest=addr)  # so they see us right away
        # "hb" (heartbeat) needs nothing more: touching the roster is the point


def keepalive(tp, room, name, host, fserver, roster, stop):
    tick, fails, warned = 0, 0, False
    while not stop.is_set():
        sent = tp.send("hb", room, name)
        if host:
            tp.send("beacon", room, name)
        if sent.ok:
            fails = 0
            if warned:
                warned = False
                say(f"{DIM}The network is back.{RESET}")
        else:
            fails += 1
            if fails >= 3 and not warned:
                warned = True
                say(f"{RED}⚠{RESET} {DIM}I can't send anything on the network right now ({tp.last_error}). "
                    f"If your Mac asked about local network access, allow it for Terminal in "
                    f"System Settings > Privacy & Security > Local Network.{RESET}")
        if tick % 10 == 9 and tp.refresh_interfaces():
            say(f"{DIM}Your network changed; reconnecting.{RESET}")
        if tick % 5 == 0 and fserver.port:
            # Re-announce shares every ~10s so people who joined late can see them.
            for token, share in list(fserver.shares.items()):
                announce(tp, roster, room, name, token, share, fserver.port)
        tick += 1
        stop.wait(2.0)


# ---------- chat session ----------

def chat(room, name, host=False, peers=()):
    ident = Identity.load() if HAVE_CRYPTO else None
    tp = open_transport(ident, peers)
    if tp is None:
        return

    if host:
        if room == GLOBAL:
            print("The global fire is always burning. Just use: campfire join")
            return tp.close()
        print(f"Checking whether '{room}' is already lit...")
        if room in find_fires(tp, 2.5, room):
            print(f"'{room}' is already burning. Join it with: campfire join {room}")
            return tp.close()
    elif room != GLOBAL:
        print(f"Looking for a fire called '{room}'...")
        if room not in find_fires(tp, 3.0, room):
            print(f"No fire found. Light it yourself with: campfire light {room}")
            print("(Or check that you're on the same Wi-Fi as the person who lit it. "
                  "If the Wi-Fi hides devices from each other, try: campfire --peer <their address> join)")
            return tp.close()

    roster = Roster(name, ident, Pins(CONFIG_DIR / "known.json") if ident else None)
    tp.learned = roster.unicast_addrs
    state = {"mute": False, "offers": [], "next": 1, "pending": {}}
    fserver = FileServer()
    temp_dirs = []
    stop = threading.Event()
    threading.Thread(target=listen, args=(tp, ident, room, name, host, roster, state, stop),
                     daemon=True).start()
    threading.Thread(target=keepalive, args=(tp, room, name, host, fserver, roster, stop),
                     daemon=True).start()

    def lookup(target):
        """Find a person by name, explaining any problem. Returns the member or None."""
        mem, problem = roster.find(target)
        if problem == "none":
            print(f"{DIM}Nobody named '{target.lstrip('@')}' is around the fire. Try /who.{RESET}")
        elif problem:
            print(f"{DIM}{problem}{RESET}")
        return mem

    def confirm_delivery(sent, ev, mem):
        try:
            for attempt in range(3):
                if ev.wait(1.5):
                    return
                if attempt < 2:
                    tp.transmit(sent.data, sent.dests)  # same message again; the receiver drops dupes
            say(f"{RED}⚠{RESET} {DIM}Couldn't confirm that {roster.label(mem)} got your whisper. "
                f"They may have left, or the network may be blocking direct messages.{RESET}")
        finally:
            state["pending"].pop(sent.mid, None)

    def cmd_whisper(rest):
        target, _, text = rest.strip().partition(" ")
        target = target.lstrip("@")
        text = text.strip()
        if not target or not text:
            print(f"{DIM}Usage: /whisper <n> <message>{RESET}")
            return
        if target.lower() == name.lower():
            print(f"{DIM}You can't whisper to yourself.{RESET}")
            return
        mem = lookup(target)
        if not mem:
            return
        if len(text) > TEXT_LIMIT:
            text = text[:TEXT_LIMIT]
            print(f"{DIM}(That's long for a whisper, so I cut it to {TEXT_LIMIT} characters.){RESET}")
        extra, body, lock = {}, text, ""
        if ident and mem["pk"]:
            extra = {"ct": b64e(ident.encrypt_for(mem["pk"], text.encode("utf-8")))}
            body, lock = "", " 🔒"
        elif ident:
            print(f"{DIM}{roster.label(mem)} isn't in secure mode, so this whisper goes only to "
                  f"them but isn't encrypted.{RESET}")
        mid = secrets.token_hex(6)
        ev = threading.Event()
        if mem["ver"] >= 2:
            state["pending"][mid] = (ev, mem["key"])  # register first: the ack can be very quick
        sent = tp.send("whisper", room, name, body, dest=mem["addr"], to=mem["name"],
                       tid=mem["sid"], mid=mid, **extra)
        print(f"{DIM}{stamp()}{RESET} {MAGENTA}[whisper to{RESET} {roster.display(mem)}{MAGENTA}]{RESET}{lock} {text}")
        if not sent.ok:
            state["pending"].pop(mid, None)
            print(f"{RED}⚠{RESET} {DIM}That didn't send: {tp.last_error}{RESET}")
        elif mem["ver"] >= 2:
            threading.Thread(target=confirm_delivery, args=(sent, ev, mem), daemon=True).start()

    def cmd_send(rest):
        path, to, use_picker = parse_send_args(rest)
        target = None
        if to:
            target, problem = roster.find(to)
            if not target:
                if use_picker:
                    print(f"{DIM}I couldn't find a file or a person called '{rest.strip()}'. "
                          f"Tip: type /send by itself and pick the file from a window.{RESET}")
                elif problem == "none":
                    print(f"{DIM}Nobody named '{to}' is around the fire. Try /who.{RESET}")
                else:
                    print(f"{DIM}{problem}{RESET}")
                return
        if use_picker:
            print(f"{DIM}A window is opening. Pick the file you want to share...{RESET}")
            path, message = pick_file()
            if not path:
                print(f"{DIM}{message}{RESET}")
                return
        elif not path:
            print(f"{DIM}I couldn't find that file. Tip: type /send by itself and pick it from a window.{RESET}")
            return
        if os.path.isdir(path):
            print(f"{DIM}That's a folder, so I'm zipping it first...{RESET}")
            try:
                tmp = tempfile.mkdtemp(prefix="campfire-")
                temp_dirs.append(tmp)
                path = shutil.make_archive(os.path.join(tmp, safe_filename(path)), "zip",
                                           root_dir=os.path.dirname(path),
                                           base_dir=os.path.basename(path))
            except (OSError, shutil.Error) as e:
                print(f"{DIM}Couldn't zip that folder: {e}{RESET}")
                return
        try:
            size = os.path.getsize(path)
            fserver.start()
        except OSError as e:
            print(f"{DIM}Couldn't share that file: {e}{RESET}")
            return
        token = secrets.token_hex(8)
        share = {"path": path, "filename": safe_filename(path), "size": size,
                 "to": target["name"] if target else None,
                 "to_key": target["key"] if target else None}
        fserver.shares[token] = share
        announce(tp, roster, room, name, token, share, fserver.port)
        who = roster.display(target) if target else "the room"
        print(f"{ORANGE}📎 Sharing{RESET} {BOLD}{share['filename']}{RESET} {DIM}({human_size(size)}){RESET} "
              f"with {who}. {DIM}It stays available while you're in this room.{RESET}")

    def cmd_files():
        if not state["offers"]:
            print(f"{DIM}Nobody is sharing anything right now.{RESET}")
            return
        for o in state["offers"]:
            print(f"  {BOLD}{o['n']}{RESET}  {o['filename']}  {DIM}({human_size(o['size'])}){RESET}  from {cname(o['from'])}")
        print(f"{DIM}Download with /get <number>{RESET}")

    def cmd_get(rest):
        arg = rest.strip()
        if not arg.isdigit():
            print(f"{DIM}Usage: /get <number>   (see /files for the list){RESET}")
            return
        offer = next((o for o in state["offers"] if o["n"] == int(arg)), None)
        if not offer:
            print(f"{DIM}There's no shared file #{arg}. Try /files.{RESET}")
            return
        print(f"{DIM}Downloading {offer['filename']}...{RESET}")
        threading.Thread(target=download_in_background, args=(offer,), daemon=True).start()

    def cmd_id(rest):
        target = rest.strip()
        if not target:
            if ident:
                print(f"{DIM}Your fingerprint:{RESET} {BOLD}{fmt_fp(ident.fp)}{RESET}  "
                      f"{DIM}(read it out to a friend so they can check it's really you){RESET}")
            else:
                print(f"{DIM}Secure mode is off, so there's no fingerprint. {SECURE_HINT}{RESET}")
            return
        mem = lookup(target)
        if mem:
            if mem["fp"]:
                print(f"{roster.display(mem)}{DIM}'s fingerprint:{RESET} {BOLD}{fmt_fp(mem['fp'])}{RESET}")
            else:
                print(f"{DIM}{roster.label(mem)} isn't in secure mode, so there's no fingerprint to check.{RESET}")

    def cmd_trust(rest):
        target = rest.strip()
        if not target:
            print(f"{DIM}Usage: /trust <n>   (only after you've checked with them that it's really them){RESET}")
            return
        if not ident:
            print(f"{DIM}Secure mode is off, so identities can't be checked. {SECURE_HINT}{RESET}")
            return
        mem = lookup(target)
        if not mem:
            return
        if not mem["pk"]:
            print(f"{DIM}{roster.label(mem)} isn't in secure mode, so there's no identity to trust.{RESET}")
            return
        roster.trust(mem)
        print(f"{DIM}OK. From now on, '{mem['name']}' means this one ({fmt_fp(mem['fp'])}).{RESET}")

    def cmd_peer(rest):
        addr = parse_peer(rest) if rest.strip() else None
        if not addr:
            print(f"{DIM}Usage: /peer <address>   (like 192.168.1.20 or their-mac.local){RESET}")
            return
        if addr not in tp.peers:
            tp.peers.append(addr)
        tp.send("hello", room, name, dest=addr)
        print(f"{DIM}Reaching out to {addr[0]}. If someone's there, they'll show up in /who.{RESET}")

    def cmd_net():
        print(f"{DIM}How campfire is reaching people:{RESET}")
        if tp.ifaces:
            for ifname, ip, bcast in tp.ifaces:
                print(f"  {BOLD}{ifname}{RESET}  {ip}  {DIM}broadcast {bcast or '255.255.255.255'}{RESET}")
        else:
            print(f"  {DIM}I couldn't detect your network, so I'm using the general broadcast address.{RESET}")
        direct = len(set(roster.unicast_addrs()))
        print(f"  {DIM}Sending directly to {direct} {'person' if direct == 1 else 'people'}"
              f"{f', plus {len(tp.peers)} added by hand' if tp.peers else ''}.{RESET}")
        print(f"  {DIM}Secure mode: {'on' if ident else 'off'}{RESET}")
        if tp.last_error:
            print(f"  {RED}Last network error: {tp.last_error}{RESET}")

    print(banner())
    verb = "lit" if host else "joined"
    print(f"{ORANGE}🔥 You {verb} '{room}' as{RESET} {cname(name)}{ORANGE}.{RESET} {DIM}Type /help for commands.{RESET}")
    if ident:
        print(f"{DIM}🔒 Secure mode: names are verified and whispers are encrypted. "
              f"Your fingerprint is {fmt_fp(ident.fp)}.{RESET}")
    else:
        print(f"{DIM}Names can't be verified and whispers aren't encrypted. {SECURE_HINT}{RESET}")
    tp.send("hello", room, name)
    for addr in tp.peers:
        tp.send("hello", room, name, dest=addr)

    try:
        while True:
            try:
                line = input("> ").strip()
            except EOFError:
                break
            if not line:
                continue

            if line.startswith("/"):
                cmd, _, rest = line.partition(" ")
                cmd = cmd.lower()

                if cmd in ("/quit", "/q", "/leave"):
                    break
                elif cmd == "/help":
                    show_help()
                elif cmd == "/who":
                    everyone = [cname(name) + DIM + " (you)" + RESET] + [roster.display(x) for x in roster.people()]
                    print(f"{DIM}Around the fire ({len(everyone)}):{RESET} " + ", ".join(everyone))
                elif cmd in ("/whisper", "/w", "/msg"):
                    cmd_whisper(rest)
                elif cmd == "/send":
                    cmd_send(rest)
                elif cmd == "/files":
                    cmd_files()
                elif cmd == "/get":
                    cmd_get(rest)
                elif cmd == "/id":
                    cmd_id(rest)
                elif cmd == "/trust":
                    cmd_trust(rest)
                elif cmd == "/peer":
                    cmd_peer(rest)
                elif cmd == "/net":
                    cmd_net()
                elif cmd == "/version":
                    print(f"{ORANGE}🔥 campfire{RESET} {BOLD}v{VERSION}{RESET}  "
                          f"{DIM}(to update: leave the room and type: campfire update){RESET}")
                elif cmd == "/mute":
                    state["mute"] = True
                    print(f"{DIM}Notifications off.{RESET}")
                elif cmd == "/unmute":
                    state["mute"] = False
                    print(f"{DIM}Notifications on.{RESET}")
                else:
                    print(f"{DIM}Unknown command '{cmd}'. Type /help to see what's available.{RESET}")
                continue

            pieces = chunk_text(line)
            for i, piece in enumerate(pieces):
                sent = tp.send("spark", room, name, piece)
                if not sent.ok:
                    print(f"{RED}⚠{RESET} {DIM}That didn't send: {tp.last_error}{RESET}")
                    break
                if i < len(pieces) - 1:
                    time.sleep(0.05)  # keep long messages in order
    except KeyboardInterrupt:
        print()
    finally:
        tp.send("bye", room, name)
        stop.set()
        fserver.close()
        for d in temp_dirs:
            shutil.rmtree(d, ignore_errors=True)
        tp.close()
        print(f"{DIM}You left the fire. 🌙{RESET}")


def list_fires(peers=()):
    tp = open_transport(None, peers)
    if tp is None:
        return
    print("Looking for fires nearby...")
    fires = find_fires(tp, 3.0)
    tp.close()
    print(f"{ORANGE}  {GLOBAL}{RESET}  (always burning)")
    for room, host in sorted(fires.items()):
        print(f"{ORANGE}  {room}{RESET}  lit by {cname(host)}")
    if not fires:
        print(f"{DIM}  No other fires. Start one with: campfire light <room>{RESET}")


def main():
    args = sys.argv[1:]
    name = os.environ.get("CAMPFIRE_NAME") or getpass.getuser()

    if "--name" in args:
        i = args.index("--name")
        if i + 1 >= len(args):
            print("--name needs a value, like: campfire --name Sam join")
            return
        name = args[i + 1]
        del args[i:i + 2]

    wanted = os.environ.get("CAMPFIRE_PEERS", "").replace(",", " ").split()
    while "--peer" in args:
        i = args.index("--peer")
        if i + 1 >= len(args):
            print("--peer needs an address, like: campfire --peer 192.168.1.20 join")
            return
        wanted.append(args[i + 1])
        del args[i:i + 2]
    peers = []
    for text in wanted:
        addr = parse_peer(text)
        if not addr:
            print(f"I couldn't find '{text}'. Use an address like 192.168.1.20 or their-mac.local")
            return
        peers.append(addr)

    name = clean(name.strip(), 24) or "stranger"

    if args and args[0] in ("version", "--version", "-v"):
        print(f"campfire v{VERSION}")
        return

    if args and args[0] in ("rm", "uninstall", "remove"):
        run_remove(assume_yes=("-y" in args or "--yes" in args))
        return

    if args and args[0] == "update":
        run_update(check_only="--check" in args)
        return

    if not args or args[0] in ("help", "-h", "--help"):
        print(banner())
        print(__doc__)
        return

    cmd = args[0]
    room = clean(args[1].lower(), 40) if len(args) > 1 else None

    if cmd == "join":
        chat(room or GLOBAL, name, peers=peers)
    elif cmd == "light":
        if not room:
            print("Give your fire a name, like: campfire light movie-night")
            return
        chat(room, name, host=True, peers=peers)
    elif cmd == "list":
        list_fires(peers)
    else:
        print(f"Unknown command '{cmd}'.")
        print(__doc__)


if __name__ == "__main__":
    main()
