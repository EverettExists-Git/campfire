# ---------- identity: who is really who (needs PyNaCl) ----------

def b64e(raw):
    return base64.b64encode(raw).decode("ascii")


def b64d(text):
    return base64.b64decode(text, validate=True)


def fingerprint(pk):
    return hashlib.sha256(pk).hexdigest()[:FP_LEN]


def fmt_fp(fp):
    return " ".join(fp[i:i + 4] for i in range(0, len(fp), 4))


def canonical(msg):
    """The exact bytes that get signed, so both sides agree what was said."""
    return json.dumps(msg, sort_keys=True, separators=(",", ":")).encode("utf-8")


class Identity:
    """Your long-term identity: a secret key kept in ~/.campfire/identity.key.

    Everything you send is signed with it, so nobody can pretend to be you, and
    whispers are encrypted so only the person you sent them to can read them.
    """

    def __init__(self, seed):
        self._signing = nacl.signing.SigningKey(seed)
        self.pk = bytes(self._signing.verify_key)
        self.fp = fingerprint(self.pk)
        self._box_key = self._signing.to_curve25519_private_key()

    @classmethod
    def load(cls, path=None):
        path = path or CONFIG_DIR / "identity.key"
        try:
            seed = b64d(path.read_text().strip())
            if len(seed) != 32:
                raise ValueError("wrong length")
        except (OSError, ValueError):
            seed = os.urandom(32)
            try:
                path.parent.mkdir(parents=True, exist_ok=True)
                os.chmod(path.parent, 0o700)
                fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, "w") as f:
                    f.write(b64e(seed) + "\n")
            except OSError:
                pass  # couldn't save it: you'll just have a new identity next time
        return cls(seed)

    def sign(self, data):
        return self._signing.sign(data).signature

    def _box(self, their_pk):
        import nacl.public
        return nacl.public.Box(self._box_key,
                               nacl.signing.VerifyKey(their_pk).to_curve25519_public_key())

    def encrypt_for(self, their_pk, plaintext):
        return bytes(self._box(their_pk).encrypt(plaintext))

    def decrypt_from(self, their_pk, ciphertext):
        return bytes(self._box(their_pk).decrypt(ciphertext))


def verify_packet(m):
    """Return the sender's public key if the packet's signature is genuine, else None."""
    try:
        pk = b64d(m["pk"])
        sig = b64d(m["sig"])
        body = {k: v for k, v in m.items() if k != "sig"}
        nacl.signing.VerifyKey(pk).verify(canonical(body), sig)
        return pk
    except Exception:
        return None


class Pins:
    """Remembers which identity went with each name, so a change gets noticed."""

    def __init__(self, path):
        self.path = path
        self.data = self._read()

    def _read(self):
        try:
            d = json.loads(self.path.read_text())
            return {str(k): str(v) for k, v in d.items()} if isinstance(d, dict) else {}
        except (OSError, ValueError):
            return {}

    def get(self, name):
        return self.data.get(name.lower())

    def set(self, name, fp):
        self.data = self._read()  # pick up changes from other campfire windows
        self.data[name.lower()] = fp
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            tmp = self.path.with_name(self.path.name + f".{os.getpid()}.tmp")
            tmp.write_text(json.dumps(self.data, indent=1))
            os.replace(tmp, self.path)
        except OSError:
            pass


# ---------- finding your networks ----------

def _mask_to_int(text):
    if text.lower().startswith("0x"):
        return int(text, 16)
    return int.from_bytes(socket.inet_aton(text), "big")


def _broadcast_for(ip, mask):
    ip_i = int.from_bytes(socket.inet_aton(ip), "big")
    return socket.inet_ntoa(((ip_i | (~mask & 0xFFFFFFFF)) & 0xFFFFFFFF).to_bytes(4, "big"))


def _usable(ip, bcast):
    return not (ip.startswith("127.") or ip.startswith("169.254.") or bcast == ip)


def parse_ifconfig(text):
    """Pull (interface, address, broadcast) out of `ifconfig` output (Mac and Linux)."""
    found, cur = [], "?"
    pat = re.compile(r"^\s+inet (\d+\.\d+\.\d+\.\d+) netmask (0x[0-9a-fA-F]+|\d+\.\d+\.\d+\.\d+)"
                     r"(?: broadcast (\d+\.\d+\.\d+\.\d+))?")
    for line in text.splitlines():
        if line and not line[0].isspace():
            cur = line.split()[0].rstrip(":")
            continue
        m = pat.match(line)
        if m:
            ip, mask, bcast = m.group(1), _mask_to_int(m.group(2)), m.group(3)
            bcast = bcast or _broadcast_for(ip, mask)
            if _usable(ip, bcast):
                found.append((cur, ip, bcast))
    return found


def parse_ip_addr(text):
    """Same thing from Linux's `ip -4 -o addr`."""
    found = []
    pat = re.compile(r"^\d+:\s+(\S+)\s+inet (\d+\.\d+\.\d+\.\d+)/(\d+)(?: brd (\d+\.\d+\.\d+\.\d+))?")
    for line in text.splitlines():
        m = pat.match(line)
        if m:
            ip, bits = m.group(2), int(m.group(3))
            bcast = m.group(4) or _broadcast_for(ip, (0xFFFFFFFF << (32 - bits)) & 0xFFFFFFFF)
            if _usable(ip, bcast):
                found.append((m.group(1), ip, bcast))
    return found


def local_interfaces():
    """Every network this computer is on: [(interface, address, broadcast address or None)]."""
    for cmd, parser in ((["/sbin/ifconfig"], parse_ifconfig), (["ifconfig"], parse_ifconfig),
                        (["ip", "-4", "-o", "addr"], parse_ip_addr)):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=3)
        except (OSError, subprocess.SubprocessError):
            continue
        found = parser(r.stdout) if r.returncode == 0 else []
        if found:
            out = []
            for item in found:
                if item not in out:
                    out.append(item)
            return out
    try:  # last resort: ask the OS which address it would use to get online
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            s.connect(("203.0.113.1", 9))  # nothing is actually sent
            ip = s.getsockname()[0]
        if not ip.startswith("127."):
            return [("?", ip, None)]
    except OSError:
        pass
    return []


def parse_peer(text):
    """'192.168.1.20', 'sams-mac.local' or '192.168.1.20:50505' -> (ip, port), or None."""
    host, _, port = text.strip().partition(":")
    try:
        return socket.gethostbyname(host), (int(port) if port else PORT)
    except (OSError, ValueError):
        return None


