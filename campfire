# ---------- chat networking (UDP broadcast) ----------

def make_socket():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    if hasattr(socket, "SO_REUSEPORT"):
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
    s.bind(("", PORT))
    s.settimeout(0.5)
    return s


def send(sock, kind, room, name, text="", to=None, **extra):
    msg = {"k": kind, "id": MY_ID, "room": room, "name": name, "text": text}
    if to:
        msg["to"] = to
    msg.update(extra)
    try:
        sock.sendto(json.dumps(msg).encode(), BROADCAST)
    except OSError:
        pass


def parse(data):
    try:
        m = json.loads(data.decode())
        return m if isinstance(m, dict) else None
    except (ValueError, UnicodeDecodeError):
        return None


def find_fires(sock, seconds=3.0):
    """Listen for beacons from lit rooms. Returns {room: host_name}."""
    fires = {}
    end = time.time() + seconds
    while time.time() < end:
        try:
            data, _ = sock.recvfrom(4096)
        except socket.timeout:
            continue
        m = parse(data)
        if m and m.get("k") == "beacon" and m.get("id") != MY_ID:
            fires[clean(m.get("room", "?"), 40)] = clean(m.get("name", "?"), 24)
    return fires


# ---------- file sharing (direct TCP) ----------

class FileServer:
    """Serves files you've offered. Starts only when you first use /send."""

    def __init__(self):
        self.shares = {}  # token -> {path, filename, size, to}
        self.sock = None
        self.port = None
        self.stop = threading.Event()

    def start(self):
        if self.sock:
            return
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind(("", 0))
        s.listen(5)
        s.settimeout(0.5)
        self.sock = s
        self.port = s.getsockname()[1]
        threading.Thread(target=self._accept_loop, daemon=True).start()

    def _accept_loop(self):
        while not self.stop.is_set():
            try:
                conn, _ = self.sock.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            threading.Thread(target=self._serve, args=(conn,), daemon=True).start()

    def _serve(self, conn):
        try:
            conn.settimeout(10)
            line = b""
            while not line.endswith(b"\n") and len(line) < 128:
                ch = conn.recv(1)
                if not ch:
                    return
                line += ch
            parts = line.decode(errors="replace").split()
            share = self.shares.get(parts[1]) if len(parts) == 2 and parts[0] == "GET" else None
            if not share or not os.path.isfile(share["path"]):
                conn.sendall(b"ERR\n")
                return
            with open(share["path"], "rb") as f:
                size = os.fstat(f.fileno()).st_size
                conn.sendall(f"OK {size}\n".encode())
                conn.settimeout(30)
                while True:
                    chunk = f.read(65536)
                    if not chunk:
                        break
                    conn.sendall(chunk)
        except OSError:
            pass
        finally:
            conn.close()

    def close(self):
        self.stop.set()
        if self.sock:
            try:
                self.sock.close()
            except OSError:
                pass


def announce(sock, room, name, token, share, port):
    send(sock, "offer", room, name, share["filename"], to=share.get("to"),
         size=share["size"], port=port, token=token)


def fetch(offer, dest_dir):
    """Download an offered file. Returns (saved_path, size). Raises OSError on failure."""
    dest_dir.mkdir(parents=True, exist_ok=True)
    with socket.create_connection((offer["ip"], offer["port"]), timeout=10) as s:
        s.settimeout(30)
        s.sendall(f"GET {offer['token']}\n".encode())
        f = s.makefile("rb")
        header = f.readline(128).decode(errors="replace").split()
        if len(header) != 2 or header[0] != "OK" or not header[1].isdigit():
            raise OSError("the sender no longer has this file")
        size = int(header[1])
        dest = unique_path(dest_dir, offer["filename"])
        part = dest.with_name(dest.name + ".part")
        try:
            with open(part, "wb") as out:
                remaining = size
                while remaining > 0:
                    chunk = f.read(min(65536, remaining))
                    if not chunk:
                        raise OSError("the connection dropped before the file finished")
                    out.write(chunk)
                    remaining -= len(chunk)
            os.replace(part, dest)
        except BaseException:
            try:
                os.remove(part)
            except OSError:
                pass
            raise
    return dest, size


def download_in_background(offer):
    try:
        dest, size = fetch(offer, DOWNLOAD_DIR)
        say(f"{ORANGE}✔{RESET} Saved {BOLD}{tilde(dest)}{RESET} {DIM}({human_size(size)}){RESET}")
    except OSError as e:
        say(f"{DIM}Couldn't download {offer['filename']}: {e}. "
            f"(The sender may have left, or a firewall may be in the way.){RESET}")


# ---------- listening ----------

def listen(sock, room, members, state, stop):
    while not stop.is_set():
        try:
            data, addr = sock.recvfrom(4096)
        except socket.timeout:
            continue
        except OSError:
            break
        m = parse(data)
        if not m or m.get("id") == MY_ID or m.get("room") != room:
            continue
        who = clean(m.get("name", "?"), 24)
        kind = m.get("k")
        muted = state["mute"]
        me = members["_me"][0]

        if kind == "spark":
            text = clean(m.get("text", ""))
            members[m["id"]] = (who, time.time())
            say(f"{DIM}{stamp()}{RESET} {cname(who)}: {text}")
            if not muted:
                notify(f"{who} in {room}", text)
        elif kind == "whisper":
            # Everyone on the network receives the packet; only the target shows it.
            if str(m.get("to", "")).lower() == me.lower():
                text = clean(m.get("text", ""))
                members[m["id"]] = (who, time.time())
                say(f"{DIM}{stamp()}{RESET} {MAGENTA}[whisper from{RESET} {cname(who)}{MAGENTA}]{RESET} {text}")
                if not muted:
                    notify(f"{who} whispered to you", text, sound="Glass", force=True)
        elif kind == "offer":
            to = m.get("to")
            if to and str(to).lower() != me.lower():
                continue  # a private offer meant for someone else
            token = str(m.get("token", ""))
            if not token or any(o["token"] == token for o in state["offers"]):
                continue  # already know about this one (offers are re-announced)
            try:
                port = int(m["port"])
                size = int(m["size"])
            except (KeyError, ValueError, TypeError):
                continue
            filename = safe_filename(m.get("text", ""))
            n = state["next"]
            state["next"] += 1
            state["offers"] = (state["offers"] + [{
                "n": n, "sender": m["id"], "from": who, "filename": filename,
                "size": size, "ip": addr[0], "port": port, "token": token,
            }])[-20:]
            members[m["id"]] = (who, time.time())
            how = "is sharing" if not to else "is privately sharing"
            say(f"{DIM}{stamp()}{RESET} {ORANGE}📎{RESET} {cname(who)} {how} {BOLD}{filename}{RESET} "
                f"{DIM}({human_size(size)}){RESET}. Type {BOLD}/get {n}{RESET} to download it.")
            if not muted:
                notify(f"{who} shared a file", f"{filename} ({human_size(size)})", sound="Glass", force=True)
        elif kind == "hello":
            members[m["id"]] = (who, time.time())
            say(f"{DIM}* {RESET}{cname(who)}{DIM} sat down by the fire{RESET}")
            send(sock, "hb", room, me)
        elif kind == "hb":
            members[m["id"]] = (who, time.time())
        elif kind == "bye":
            members.pop(m["id"], None)
            state["offers"] = [o for o in state["offers"] if o["sender"] != m["id"]]
            say(f"{DIM}* {RESET}{cname(who)}{DIM} wandered off{RESET}")


def keepalive(sock, room, name, host, fserver, stop):
    tick = 0
    while not stop.is_set():
        send(sock, "hb", room, name)
        if host:
            send(sock, "beacon", room, name)
        if tick % 5 == 0 and fserver.port:
            # Re-announce shares every ~10s so people who joined late can see them.
            for token, share in list(fserver.shares.items()):
                announce(sock, room, name, token, share, fserver.port)
        tick += 1
        stop.wait(2.0)


# ---------- chat session ----------

def active_members(members):
    now = time.time()
    return {k: v[0] for k, v in members.items() if k != "_me" and now - v[1] < 12}


def chat(room, name, host=False):
    sock = make_socket()

    if host:
        if room == GLOBAL:
            print("The global fire is always burning. Just use: campfire join")
            return
        print(f"Checking whether '{room}' is already lit...")
        if room in find_fires(sock, 2.5):
            print(f"'{room}' is already burning. Join it with: campfire join {room}")
            return
    elif room != GLOBAL:
        print(f"Looking for a fire called '{room}'...")
        if room not in find_fires(sock, 3.0):
            print(f"No fire found. Light it yourself with: campfire light {room}")
            print("(Or check that you're on the same Wi-Fi as the person who lit it.)")
            return

    members = {"_me": (name, time.time())}
    state = {"mute": False, "offers": [], "next": 1}
    fserver = FileServer()
    temp_dirs = []
    stop = threading.Event()
    threading.Thread(target=listen, args=(sock, room, members, state, stop), daemon=True).start()
    threading.Thread(target=keepalive, args=(sock, room, name, host, fserver, stop), daemon=True).start()

    def find_member(target):
        return next((n for n in active_members(members).values() if n.lower() == target.lower()), None)

    def cmd_whisper(rest):
        target, _, text = rest.strip().partition(" ")
        target = target.lstrip("@")
        text = text.strip()
        if not target or not text:
            print(f"{DIM}Usage: /whisper <name> <message>{RESET}")
        elif target.lower() == name.lower():
            print(f"{DIM}You can't whisper to yourself.{RESET}")
        else:
            match = find_member(target)
            if not match:
                print(f"{DIM}Nobody named '{target}' is around the fire. Try /who.{RESET}")
            else:
                send(sock, "whisper", room, name, text, to=match)
                print(f"{DIM}{stamp()}{RESET} {MAGENTA}[whisper to{RESET} {cname(match)}{MAGENTA}]{RESET} {text}")

    def cmd_send(rest):
        path, to, use_picker = parse_send_args(rest)
        if to:
            match = find_member(to.lstrip("@"))
            if not match:
                if use_picker:
                    print(f"{DIM}I couldn't find a file or a person called '{rest.strip()}'. "
                          f"Tip: type /send by itself and pick the file from a window.{RESET}")
                else:
                    print(f"{DIM}Nobody named '{to}' is around the fire. Try /who.{RESET}")
                return
            to = match
        if use_picker:
            print(f"{DIM}A window is opening. Pick the file you want to share...{RESET}")
            path, message = pick_file()
            if not path:
                print(f"{DIM}{message}{RESET}")
                return
        elif not path:
            print(f"{DIM}I couldn't find that file. Tip: type /send by itself and pick it from a window.{RESET}")
            return
        if os.path.isdir(path):
            print(f"{DIM}That's a folder, so I'm zipping it first...{RESET}")
            try:
                tmp = tempfile.mkdtemp(prefix="campfire-")
                temp_dirs.append(tmp)
                path = shutil.make_archive(os.path.join(tmp, safe_filename(path)), "zip",
                                           root_dir=os.path.dirname(path),
                                           base_dir=os.path.basename(path))
            except (OSError, shutil.Error) as e:
                print(f"{DIM}Couldn't zip that folder: {e}{RESET}")
                return
        try:
            size = os.path.getsize(path)
            fserver.start()
        except OSError as e:
            print(f"{DIM}Couldn't share that file: {e}{RESET}")
            return
        token = secrets.token_hex(8)
        share = {"path": path, "filename": safe_filename(path), "size": size, "to": to}
        fserver.shares[token] = share
        announce(sock, room, name, token, share, fserver.port)
        who = cname(to) if to else "the room"
        print(f"{ORANGE}📎 Sharing{RESET} {BOLD}{share['filename']}{RESET} {DIM}({human_size(size)}){RESET} "
              f"with {who}. {DIM}It stays available while you're in this room.{RESET}")

    def cmd_files():
        if not state["offers"]:
            print(f"{DIM}Nobody is sharing anything right now.{RESET}")
            return
        for o in state["offers"]:
            print(f"  {BOLD}{o['n']}{RESET}  {o['filename']}  {DIM}({human_size(o['size'])}){RESET}  from {cname(o['from'])}")
        print(f"{DIM}Download with /get <number>{RESET}")

    def cmd_get(rest):
        arg = rest.strip()
        if not arg.isdigit():
            print(f"{DIM}Usage: /get <number>   (see /files for the list){RESET}")
            return
        offer = next((o for o in state["offers"] if o["n"] == int(arg)), None)
        if not offer:
            print(f"{DIM}There's no shared file #{arg}. Try /files.{RESET}")
            return
        print(f"{DIM}Downloading {offer['filename']}...{RESET}")
        threading.Thread(target=download_in_background, args=(offer,), daemon=True).start()

    print(banner())
    verb = "lit" if host else "joined"
    print(f"{ORANGE}🔥 You {verb} '{room}' as{RESET} {cname(name)}{ORANGE}.{RESET} {DIM}Type /help for commands.{RESET}")
    send(sock, "hello", room, name)

    try:
        while True:
            try:
                line = input("> ").strip()
            except EOFError:
                break
            if not line:
                continue

            if line.startswith("/"):
                cmd, _, rest = line.partition(" ")
                cmd = cmd.lower()

                if cmd in ("/quit", "/q", "/leave"):
                    break
                elif cmd == "/help":
                    show_help()
                elif cmd == "/who":
                    others = sorted(active_members(members).values(), key=str.lower)
                    everyone = [cname(name) + DIM + " (you)" + RESET] + [cname(n) for n in others]
                    print(f"{DIM}Around the fire ({len(everyone)}):{RESET} " + ", ".join(everyone))
                elif cmd in ("/whisper", "/w", "/msg"):
                    cmd_whisper(rest)
                elif cmd == "/send":
                    cmd_send(rest)
                elif cmd == "/files":
                    cmd_files()
                elif cmd == "/get":
                    cmd_get(rest)
                elif cmd == "/version":
                    print(f"{ORANGE}🔥 campfire{RESET} {BOLD}v{VERSION}{RESET}  "
                          f"{DIM}(to update: leave the room and type: campfire update){RESET}")
                elif cmd == "/mute":
                    state["mute"] = True
                    print(f"{DIM}Notifications off.{RESET}")
                elif cmd == "/unmute":
                    state["mute"] = False
                    print(f"{DIM}Notifications on.{RESET}")
                else:
                    print(f"{DIM}Unknown command '{cmd}'. Type /help to see what's available.{RESET}")
                continue

            send(sock, "spark", room, name, line)
    except KeyboardInterrupt:
        print()
    finally:
        send(sock, "bye", room, name)
        stop.set()
        fserver.close()
        for d in temp_dirs:
            shutil.rmtree(d, ignore_errors=True)
        sock.close()
        print(f"{DIM}You left the fire. 🌙{RESET}")


def list_fires():
    sock = make_socket()
    print("Looking for fires nearby...")
    fires = find_fires(sock, 3.0)
    sock.close()
    print(f"{ORANGE}  {GLOBAL}{RESET}  (always burning)")
    for room, host in sorted(fires.items()):
        print(f"{ORANGE}  {room}{RESET}  lit by {cname(host)}")
    if not fires:
        print(f"{DIM}  No other fires. Start one with: campfire light <room>{RESET}")


def main():
    args = sys.argv[1:]
    name = os.environ.get("CAMPFIRE_NAME") or getpass.getuser()

    if "--name" in args:
        i = args.index("--name")
        if i + 1 >= len(args):
            print("--name needs a value, like: campfire --name Sam join")
            return
        name = args[i + 1]
        del args[i:i + 2]

    name = clean(name.strip(), 24) or "stranger"

    if args and args[0] in ("version", "--version", "-v"):
        print(f"campfire v{VERSION}")
        return

    if args and args[0] in ("rm", "uninstall", "remove"):
        run_remove(assume_yes=("-y" in args or "--yes" in args))
        return

    if args and args[0] == "update":
        run_update(check_only="--check" in args)
        return

    if not args or args[0] in ("help", "-h", "--help"):
        print(banner())
        print(__doc__)
        return

    cmd = args[0]
    room = clean(args[1].lower(), 40) if len(args) > 1 else None

    if cmd == "join":
        chat(room or GLOBAL, name)
    elif cmd == "light":
        if not room:
            print("Give your fire a name, like: campfire light movie-night")
            return
        chat(room, name, host=True)
    elif cmd == "list":
        list_fires()
    else:
        print(f"Unknown command '{cmd}'.")
        print(__doc__)


if __name__ == "__main__":
    main()
